َ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ",[4,6,2,6,8,5,20,24,16,29,32,8,46,51,11,61,62,0,66,69,9,69,70,3,77,80,8,88,89,0,89,90,1]],["يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى",[10,11,3]],["فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ",[11,17,12,38,40,6,45,46,17]],["وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ",[23,25,6,30,31,17]],["يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ",[2,4,6,15,16,0,16,17,1,17,20,8,25,26,0,30,32,17,36,39,8]],["ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ",[7,9,6,33,39,11]],["فَٱدْخُلِى فِى عِبَٰدِى",[2,3,0,3,5,17,19,20,3]],["وَٱدْخُلِى جَنَّتِى",[2,3,0,3,5,17,13,16,8]]]}}